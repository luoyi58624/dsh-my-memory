{
  "name": "@local/dsh-my-memory",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 的全局提示词、角色设定和每角色 Markdown 长期记忆",
  "type": "module",
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./preset-solo": "./lib/host/preset-solo.js",
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/",
    "test:memory": "node --test test/documents.test.mjs test/document-editor.test.mjs test/prompts.test.mjs test/plugin.test.mjs test/preset-solo.test.mjs test/personas.test.mjs test/store.test.mjs test/rev.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
